{
  // Баба Яга: генерал Нави (game-design §6.2, roadmap 0.18.0).
  // Постоянный полёт: игнорирует рельеф, ямы и запрет перехода через два яруса;
  // укрытий не получает (math §9.5). Применяет умения контроля (паника, корни).
  // Пороговый уход: при 0 < hp ≤ fleeHp покидает поле без гибели и может
  // вернуться в последующей миссии; гибель окончательна (кампания не
  // возвращает погибшего генерала).
  id: "baba_yaga",
  classId: "baba_yaga",
  side: "nav",
  maxHealth: 24,
  maxAP: 2,
  mobility: 4,
  aim: 80,
  defense: 5,
  will: 90,
  vision: 14,
  weapons: ["branch"],
  skills: ["panic", "roots"],
  tags: ["flying"],
  fleeHp: 6,
}
