// Цепочка М1–М4. Этап 1: данные закрыты флагом enabled.
{
  enabled: true,
  roster: ["mikula_peasant", "fedot_stranded", "bogatyr", "strelets", "znaharka"],
  prologueFinalMissionId: "prologue_village",
  missions: [
    {
      id: "prologue_brushwood",
      titleKey: "prologue.m1.title",
      introKey: "prologue.m1.intro",
      outroKey: "prologue.m1.outro",
      nextMissionId: "prologue_cry",
      playerSlots: ["mikula_peasant"],
      fog: false,
      map: {
        biome: "meadow",
        width: 20,
        height: 6,
        pitChance: 0.0,
        coverDensity: 0.0,
        wallDensity: 0.0,
        edgeCoverChance: 0.0,
        halfCoverChance: 0.0,
        heightMix: { z0: 0.0, z1: 1.0, z2: 0.0 },
        layout: {
          // Околица Выселок: на севере — пологие всхолмления с валунами,
          // по центру — ровная тропа от околицы к поляне, на юге — сухой
          // ручей в низине. Ярусы заданы параллельно рядам: символы внутри
          // `rows` стали бы ложными маркерами (см. prologue-layout.ts).
          rows: [
            ".t..W....t....W...t.",
            "..t.....t...t....t..",
            "..................F.",
            ".M..t.......t..t...S",
            "..t.....t.......t...",
            ".t..W....t....W..t..",
          ],
          // Рельеф по клеткам: 0 — низина, 1 — луг, 2 — всхолмление.
          // Тропа (ряд 3), старт Микулы (1,3), палка (19,3) и точка выхода
          // крысы (18,2) держатся на одном ярусе: перепад дал бы стороне
          // лишнюю поправку к меткости в учебном бою.
          heights: [
            "11122221111111122111",
            "11122211111111112211",
            "11111211111111111111",
            "11111111111111111111",
            "11000011111000111111",
            "10000011100000011111",
          ],
          legend: {
            ".": { kind: "ground" },
            "t": { kind: "decor", decor: "bush" },
            "W": { kind: "wall" },
            "M": { kind: "spawn", side: "player", unitId: "mikula_peasant" },
            "S": { kind: "pickup", itemId: "stick", weaponId: "club" },
            "F": { kind: "spawn", side: "enemy", unitId: "forest_rat", scripted: true },
          },
        },
      },
      enemies: [],
      objective: {
        initialTextKey: "prologue.objective.gather",
        retarget: [
          { onKey: "stick", textKey: "prologue.objective.destroyAll" },
        ],
      },
      script: {
        priority: [],
        actions: [
          // Крыса кусает сразу после вбегания. Исход «min» — укус обязан
          // состояться (сцена обещает опасность), но это минимальный урон
          // зубов: учебный бой не вправе искалечить героя случайным
          // максимумом (0.20.40).
          { unitId: "forest_rat", side: "enemy", kind: "attack", targetUnitId: "mikula_peasant", weaponId: "teeth", forceOutcome: "min", onlyIf: "targetAlive" },
          { kind: "endTurn" },
        ],
      },
      // Режиссура камеры (campaign.md §13.4). Описана данными, а не кодом
      // экрана: тот же проигрыватель обслуживает выход Федота (М2), новую
      // волну (М3) и посадку корабля (М6).
      cutscenes: [
        {
          id: "m1_intro",
          trigger: { kind: "missionStart" },
          lockInput: true,
          skippable: true,
          // Крупнее игрового кадра: при подгонке «поле целиком» камере
          // некуда ехать. После сцены масштаб возвращается.
          zoom: 1.9,
          steps: [
            // Акцент на герое: кто перед нами и где он стоит. Первый шаг —
            // проездом, а не мгновенным кадром: приближение уже держит героя
            // в центре, подводка доводит кадр без скачка.
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 420, holdMs: 600 },
            // Камера уходит к палке и подсвечивает её янтарным кольцом:
            // цель названа изображением и светом, без текста (0.20.40).
            { kind: "pan", target: { marker: "S" }, durationMs: 1000, holdMs: 800, accent: true },
            // Возврат к герою, после которого управление отдаётся игроку.
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 800 },
          ],
        },
        {
          id: "m1_rat_appear",
          trigger: { kind: "onSpawn", configId: "forest_rat" },
          lockInput: true,
          skippable: true,
          steps: [
            // Камера встаёт на опушку — туда, откуда выбежит крыса, — и
            // ведёт её до клетки: появление не телепортация, а пробег
            // (0.20.40, follow).
            { kind: "pan", target: { configId: "forest_rat" }, durationMs: 420, runInMs: 620, follow: true, holdMs: 300 },
            // Передача хода Нави: крыса кусает героя сразу, а не когда
            // игрок догадается нажать «Конец хода». Удар разыгрывается
            // обычными событиями боя — камера берёт его в кадр сама.
            { kind: "handOff" },
            // Возврат к герою — и начало хода игрока.
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 600 },
          ],
        },
      ],
      hints: ["m1.endTurn"],
      // Пока крыса жива, кнопка дубины пульсирует янтарным: сцена
      // показывает, что делать дальше, не объясняя словами (0.20.40).
      actionAccent: { weaponId: "club", whileAlive: "forest_rat" },
      onboarding: [],
      checkpoints: [
        { id: "start", description: "Вход в миссию" },
        { id: "rat_spawn", onKey: "stick", description: "Появление крысы" },
      ],
    },
    {
      id: "prologue_cry",
      titleKey: "prologue.m2.title",
      introKey: "prologue.m2.intro",
      outroKey: "prologue.m2.outro",
      nextMissionId: "prologue_glade",
      playerSlots: ["mikula_peasant"],
      fog: false,
      map: {
        biome: "swamp",
        width: 12,
        height: 9,
        pitChance: 0.0,
        coverDensity: 0.0,
        wallDensity: 0.0,
        edgeCoverChance: 0.0,
        halfCoverChance: 0.0,
        heightMix: { z0: 0.0, z1: 1.0, z2: 0.0 },
        extract: true,
        layout: {
          // Дизайн карты М2 (0.20.44, клетки стаи — 0.20.45). Болото: запад — сухая кромка, откуда
          // уходят к эвакуации; восток и юго-восток — низина трясины, в
          // которой увяз Федот; север — чаща, из кустов выбегают крысы.
          // Рельеф ведёт бой: кочки (ярус 2) дают выигрыш высоты и меткости,
          // спуск в трясину стоит одно очко движения, а подъём из неё — два,
          // поэтому низина удерживает, а не просто украшает поле. Прохода
          // «в лоб» через трясину нет: к Федоту ведут две сухие перемычки
          // (ряд 6 у кочки и ряд 7 у кромки), и выбор между ними — первый
          // тактический выбор миссии.
          rows: [
            "Ett..c.StSWS",
            "E...c..StS.S",
            "E.M...t.....",
            "..c..t..t...",
            "........cF..",
            ".c....t..t..",
            "E...c....V..",
            "E......t...c",
            "Ett.....ttW.",
          ],
          // Ярусы по клеткам: 0 — трясина (низина), 1 — топкий берег,
          // 2 — сухая кочка. Скачков в два яруса между соседями нет:
          // переход «низина → кочка» всегда идёт через берег.
          heights: [
            "112211111111",
            "112211111111",
            "111111101111",
            "112110000111",
            "111110000111",
            "111110000011",
            "111121000011",
            "112111100011",
            "111111111111",
          ],
          legend: {
            ".": { kind: "ground" },
            // `t` — камыш и кустарник: проход не закрывает, но именно из
            // него по сценарию выбегают крысы.
            "t": { kind: "decor", decor: "bush" },
            "c": { kind: "cover", coverType: 1 },
            "W": { kind: "wall" },
            "E": { kind: "extract" },
            // Герой выходит на ночь с дубиной, найденной в М1 (0.20.45):
            // канон §6.1 и реплика «их будет больше, чем палки».
            "M": { kind: "spawn", side: "player", unitId: "mikula_peasant", weapons: ["club"] },
            "V": { kind: "stranded", unitId: "fedot_stranded", state: "immobile" },
            // `F` — точка засады: первая пара крыс выбегает отсюда, когда
            // герой примет стойку. `S` — шесть клеток стаи: крысы
            // выбегают из чащи разом, как только Федот освобождён.
            "F": { kind: "spawn", side: "enemy", unitId: "forest_rat", scripted: true },
          },
        },
      },
      enemies: [],
      objective: {
        initialTextKey: "prologue.objective.rescueFedot",
      },
      script: {
        priority: [],
        actions: [
          { unitId: "forest_rat", side: "enemy", kind: "attack", targetUnitId: "mikula_peasant", weaponId: "teeth", forceOutcome: "miss" },
          { unitId: "forest_rat", side: "enemy", kind: "attack", targetUnitId: "mikula_peasant", weaponId: "teeth", forceOutcome: "hit" },
          { kind: "endTurn" },
        ],
      },
      hints: ["m2.noise", "m2.stanceWorks", "m2.wave", "m2.gear"],
      // Режиссура камеры М2 (0.20.45, campaign.md §7.2 и §13.4). Четыре
      // сцены ведут миссию: вступление называет цель, засада показывает
      // первую пару крыс и передаёт им ход, стая — шесть крыс разом, и
      // последняя сцена открывает зону эвакуации, когда она загорелась.
      cutscenes: [
        {
          id: "m2_intro",
          trigger: { kind: "missionStart" },
          lockInput: true,
          skippable: true,
          zoom: 1.7,
          steps: [
            // Кто перед нами и где он стоит.
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 420, holdMs: 600 },
            // Крик из чащи: камера уходит к Федоту и подсвечивает его —
            // цель миссии названа изображением, без слов.
            { kind: "pan", target: { marker: "V" }, durationMs: 1100, holdMs: 900, accent: true },
            // Возврат к герою: дальше играет игрок.
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 800 },
          ],
        },
        {
          // Засада — единственный раз, когда появление крыс передаёт им
          // ход: обе кусают сразу, промах и попадание по канону (§7.2).
          id: "m2_ambush",
          trigger: { kind: "onSpawn", configId: "forest_rat" },
          once: true,
          lockInput: true,
          skippable: true,
          zoom: 1.7,
          steps: [
            { kind: "pan", target: { configId: "forest_rat" }, durationMs: 420, runInMs: 620, follow: true, holdMs: 300 },
            { kind: "handOff" },
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 600 },
          ],
        },
        {
          // Стая. Ход Нави не передаётся: игроку оставляют его ход, чтобы
          // он успел побежать к выходу.
          id: "m2_swarm",
          trigger: { kind: "onSpawn", configId: "forest_rat" },
          lockInput: true,
          skippable: true,
          zoom: 1.5,
          steps: [
            { kind: "pan", target: { configId: "forest_rat" }, durationMs: 420, runInMs: 620, follow: true, holdMs: 500 },
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 600 },
          ],
        },
        {
          // Зона эвакуации загорелась: камера показывает выход и
          // возвращается к отряду.
          id: "m2_extract",
          trigger: { kind: "onFlag", flag: "extractRevealed" },
          lockInput: true,
          skippable: true,
          zoom: 1.5,
          steps: [
            { kind: "pan", target: { cell: { x: 0, y: 7 } }, durationMs: 900, holdMs: 800, accent: true },
            { kind: "pan", target: { configId: "mikula_peasant" }, durationMs: 700 },
          ],
        },
      ],
      onboarding: [],
      checkpoints: [
        { id: "start", description: "Вход в миссию" },
        { id: "fedot_freed", onKey: "fedotFreed", description: "После освобождения Федота" },
      ],
      reinforcements: "m2_cry_wave",
    },
    {
      id: "prologue_glade",
      titleKey: "prologue.m3.title",
      introKey: "prologue.m3.intro",
      outroKey: "prologue.m3.outro",
      nextMissionId: "prologue_village",
      playerSlots: ["bogatyr"],
      fog: true,
      map: {
        biome: "thicket",
        width: 12,
        height: 9,
        pitChance: 0.0,
        coverDensity: 0.0,
        wallDensity: 0.0,
        edgeCoverChance: 0.0,
        halfCoverChance: 0.0,
        heightMix: { z0: 0.1, z1: 0.8, z2: 0.1 },
        layout: {
          rows: [
            "tt...t...ttt",
            "t.........t.",
            "...P........",
            ".M...U......",
            "......P.....",
            "..........A.",
            "t......SS..t",
            "tt..t...t.tt",
            "tttttttttttt",
          ],
          legend: {
            ".": { kind: "ground" },
            "t": { kind: "decor", decor: "bush" },
            "P": { kind: "pit" },
            "M": { kind: "spawn", side: "player", unitId: "bogatyr" },
            "U": { kind: "spawn", side: "enemy", unitId: "upyr" },
            "S": { kind: "spawn", side: "enemy", unitId: "upyr", scripted: true },
            "A": { kind: "spawn", side: "player", unitId: "strelets", scripted: true },
          },
        },
      },
      enemies: [{ unitId: "upyr", count: 1 }],
      objective: {
        initialTextKey: "prologue.objective.clearGlade",
      },
      script: {
        priority: [],
        actions: [
          { unitId: "strelets", side: "player", kind: "appear", at: { x: 10, y: 5 } },
          { unitId: "strelets", side: "player", kind: "attack", targetUnitId: "upyr", weaponId: "bow", forceOutcome: "hit" },
          { kind: "endTurn" },
        ],
      },
      hints: ["m3.blow", "m3.pit", "m3.more", "m3.shot"],
      onboarding: [],
      checkpoints: [
        { id: "start", description: "Вход в миссию" },
        { id: "after_first_wave", onKey: "firstWave", description: "После второй волны упырей" },
      ],
    },
    {
      id: "prologue_village",
      titleKey: "prologue.m4.title",
      introKey: "prologue.m4.intro",
      outroKey: "prologue.m4.outro",
      nextMissionId: null,
      playerSlots: ["bogatyr", "strelets"],
      fog: true,
      map: {
        biome: "meadow",
        width: 14,
        height: 9,
        pitChance: 0.0,
        coverDensity: 0.0,
        wallDensity: 0.0,
        edgeCoverChance: 0.0,
        halfCoverChance: 0.0,
        heightMix: { z0: 0.1, z1: 0.8, z2: 0.1 },
        layout: {
          rows: [
            "WWW..WWW..WWWW",
            "W.W..W.W..W.HW",
            "........c....z",
            "M...U..K.....z",
            "A.....U...K..W",
            "...t..c......W",
            "W............W",
            "WW..t..WW..WWW",
            "..............",
          ],
          legend: {
            ".": { kind: "ground" },
            "W": { kind: "wall" },
            "c": { kind: "cover", coverType: 1 },
            "t": { kind: "decor", decor: "bush" },
            "M": { kind: "spawn", side: "player", unitId: "bogatyr" },
            "A": { kind: "spawn", side: "player", unitId: "strelets" },
            "U": { kind: "spawn", side: "enemy", unitId: "upyr" },
            "K": { kind: "spawn", side: "enemy", unitId: "kikimora" },
            "H": { kind: "decor", decor: "hut" },
            "z": { kind: "spawn", side: "player", unitId: "znaharka", scripted: true },
          },
        },
      },
      enemies: [
