            "M": { kind: "spawn", side: "player", unitId: "bogatyr", weapons: ["club"] },
            "U": { kind: "spawn", side: "enemy", unitId: "upyr" },
            "R": { kind: "spawn", side: "enemy", unitId: "upyr", scripted: true },
            "S": { kind: "spawn", side: "enemy", unitId: "upyr", scripted: true },
