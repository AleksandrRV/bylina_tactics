{
  // Режим обучения (0.19.0, game-design §3.5, roadmap §7.2).
  // Три миссии: «Первые шаги», «Бой», «Умения и состояния».
  // Игрок проходит их последовательно либо выбирает любую для повторения.
  //
  // Строгий сценарий (0.20.13): каждый шаг игрока предписывает ровно одно
  // действие конкретного бойца (actorUnitId) — точную клетку, оружие, умение
  // и цель; иные действия интерфейс не исполняет (ui-design §4.5). Ходы Нави
  // заданы полем enemyScript: постоянные правила (priority) и линейная
  // очередь действий (actions) с маркерами конца хода. Окружение фиксировано
  // постоянным seed, поэтому вся партия воспроизводима шаг за шагом.
  missions: [
    {
      id: "movement",
      titleKey: "training.movement.title",
      descriptionKey: "training.movement.description",
      map: {
        width: 10,
        height: 8,
        pitChance: 0.08,
        coverDensity: 0.02,
        wallDensity: 0.02,
        edgeCoverChance: 0.3,
        halfCoverChance: 0.5,
        // Доводка 0.20.2: доля верхнего яруса поднята — урок «ярусы»
        // заметнее (прежняя карта имела лишь пару клеток z2).
        heightMix: { z0: 0.2, z1: 0.55, z2: 0.25 },
      },
      playerSlots: ["bogatyr"],
      // «Первые шаги» учат перемещению и рывку: противник здесь ни к чему и
      // только отвлекает (game-design §3.5, требование доработки обучения).
      // Окружение фиксировано — генератор получает постоянный seed, поэтому
      // ямы, укрытия и ярусы одинаковы при каждом прохождении.
      enemies: [],
      // Доводка 0.20.1: добавлен явный шаг «рывок» — перемещение за два
      // очка действия (шаги 3 и 5 — завершение хода между перемещениями).
      hints: [
        {
          step: 1,
          textKey: "training.movement.hint1",
          highlight: "panel",
          panelKey: "ap",
          until: "noop",
          actorUnitId: "bogatyr",
        },
        {
          step: 2,
          textKey: "training.movement.hint2",
          highlight: "cell",
          until: "move",
          actorUnitId: "bogatyr",
        },
        {
          step: 3,
          textKey: "training.movement.hint3",
          highlight: "button",
          panelKey: "end_turn",
          until: "end_turn",
          actorUnitId: "bogatyr",
        },
        {
          step: 4,
          textKey: "training.movement.hint4",
          highlight: "cell",
          until: "dash",
          actorUnitId: "bogatyr",
        },
        {
          step: 5,
          textKey: "training.movement.hint5",
          highlight: "button",
          panelKey: "end_turn",
          until: "end_turn",
          actorUnitId: "bogatyr",
        },
      ],
    },
    {
      id: "combat",
      titleKey: "training.combat.title",
      descriptionKey: "training.combat.description",
      // Доводка 0.20.1: minCovers гарантирует укрытие на карте — подсказка
      // про укрытие не бывает ложной; текст объясняет вероятность.
      map: {
        // 0.20.43: поле сужено до минимума по схеме (8×8), ямы и стены
        // убраны. При норме движения 4 ОД за 1 ОД упырь на дальней кромке
        // заставлял бы тратить рывок (2 ОД) только на сближение, и урок
        // «подойди и ударь» перестал бы выполняться за один ход. Укрытия
        // и перепады высот оставлены: подсказки учат бить сбоку и сверху.
        width: 8,
        height: 8,
        pitChance: 0,
        coverDensity: 0.08,
        wallDensity: 0,
        edgeCoverChance: 0.4,
        halfCoverChance: 0.5,
        heightMix: { z0: 0.15, z1: 0.7, z2: 0.15 },
        minCovers: 2,
      },
      playerSlots: ["bogatyr"],
      enemies: [{ unitId: "upyr", count: 1 }],
      // Сценарий (0.20.13): упырь сближается и бьёт когтями Богатыря;
      // после исчерпания очереди действует обычный алгоритм.
      enemyScript: {
        priority: [],
        actions: [
          { unitId: "upyr", kind: "attack", targetUnitId: "bogatyr", weaponId: "claws" },
          { kind: "endTurn" },
        ],
      },
      hints: [
        {
          step: 1,
          textKey: "training.combat.hint1",
          highlight: "panel",
          panelKey: "weapon",
          until: "noop",
          actorUnitId: "bogatyr",
        },
        {
          step: 2,
          textKey: "training.combat.hint2",
          highlight: "entity",
          targetUnitId: "upyr",
          until: "approach",
          actorUnitId: "bogatyr",
        },
        {
          step: 3,
          textKey: "training.combat.hint3",
          highlight: "entity",
          targetUnitId: "upyr",
          panelKey: "weapon",
          until: "attack",
          actorUnitId: "bogatyr",
          weaponId: "sword",
          repeatUntil: "targetDead",
        },
      ],
    },
    {
      // «Умения и состояния» (0.19.1): кикимора вводит отравление и
      // воскрешение костяка, знахарка — лечение, очищение и призыв зверя;
      // дозор и туман войны действуют как обычно. Состав соответствует
      // описанию миссии (game-design §3.5).
      // Доводка 0.20.2: Навь в миссии действует, поэтому высадке дан и
      // Стрелец — дистанционный боец делает бой посильным для новичка.
      id: "skills",
      titleKey: "training.skills.title",
      descriptionKey: "training.skills.description",
      map: {
        width: 10,
        height: 8,
        pitChance: 0.04,
        coverDensity: 0.06,
        wallDensity: 0.02,
        edgeCoverChance: 0.4,
        halfCoverChance: 0.5,
        heightMix: { z0: 0.15, z1: 0.7, z2: 0.15 },
      },
      playerSlots: ["bogatyr", "znaharka", "strelets"],
      enemies: [
        { unitId: "upyr", count: 1 },
        { unitId: "kikimora", count: 1 },
      ],
      // Сценарий Нави (0.20.13): постоянное правило — кикимора поднимает
      // погибшего упыря, как только появится тело (урок воскрешения);
      // первые два хода расписаны: отравление Богатыря, затем атаки.
      enemyScript: {
        priority: [
          { unitId: "kikimora", kind: "resurrect", corpseUnitId: "upyr", skillId: "raise_skeleton" },
        ],
        actions: [
          { unitId: "kikimora", kind: "skill", skillId: "poison_needles", targetUnitId: "bogatyr" },
          { unitId: "upyr", kind: "attack", targetUnitId: "bogatyr", weaponId: "claws" },
          { kind: "endTurn" },
          { unitId: "upyr", kind: "attack", targetUnitId: "bogatyr", weaponId: "claws" },
          { unitId: "kikimora", kind: "attack", targetUnitId: "strelets", weaponId: "needle" },
          { kind: "endTurn" },
        ],
      },
      hints: [
        {
          // Урок призыва: Знахарка зовёт лесного зверя в подсвеченную клетку.
          step: 1,
          textKey: "training.skills.hint1",
          highlight: "cell",
          panelKey: "skill",
          until: "skill",
          actorUnitId: "znaharka",
          skillId: "summon_forest_beast",
        },
        {
          // Урок дозора: Стрелец стережет сектор на подступах.
          step: 2,
          textKey: "training.skills.hint2",
          highlight: "panel",
          panelKey: "overwatch",
          until: "overwatch",
          actorUnitId: "strelets",
        },
        {
          // Яд Нави показателен лишь в её ход — завершаем свой.
          step: 3,
          textKey: "training.skills.hint3",
          highlight: "button",
          panelKey: "end_turn",
          until: "end_turn",
        },
        {
          // Урок очищения: снять яд отравления с Богатыря.
          step: 4,
          textKey: "training.skills.hint4",
          highlight: "entity",
          targetUnitId: "bogatyr",
          panelKey: "skill",
          until: "skill",
          actorUnitId: "znaharka",
          skillId: "cleanse",
        },
        {
          // Урок стойки: Богатырь встречает упыря щитом.
          step: 5,
          textKey: "training.skills.hint5",
          highlight: "panel",
          panelKey: "defend",
          until: "defend",
          actorUnitId: "bogatyr",
        },
        {
          // Урок дистанции: Стрелец разит кикимору из лука.
          step: 6,
          textKey: "training.skills.hint6",
          highlight: "entity",
          targetUnitId: "kikimora",
          panelKey: "weapon",
          until: "attack",
          actorUnitId: "strelets",
          weaponId: "bow",
        },
        {
          step: 7,
          textKey: "training.skills.hint7",
          highlight: "button",
          panelKey: "end_turn",
          until: "end_turn",
        },
        {
          // Урок лечения: вернуть силы самому раненому.
          step: 8,
          textKey: "training.skills.hint8",
          highlight: "entity",
          panelKey: "skill",
          until: "skill",
          actorUnitId: "znaharka",
          skillId: "heal",
        },
        {
          // Финал (строгий сценарий): указания ведут бой до победы.
          step: 9,
          textKey: "training.skills.hint9",
          highlight: "entity",
          panelKey: "weapon",
          until: "attack",
          repeatUntil: "victory",
        },
      ],
      // Доводка 0.20.1: реактивные подсказки на отравление, воскрешение
      // и призыв показываются плашками в бою (ключи training.skills.note*).
      notes: {
        poison: "training.skills.notePoison",
        resurrect: "training.skills.noteResurrect",
        summon: "training.skills.noteSummon",
      },
    },
  ],
}
