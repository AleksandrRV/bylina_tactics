{
  // Режим обучения (0.19.0, base-design §3.5, roadmap §7.2).
  // Три миссии: «Первые шаги», «Бой», «Умения и состояния».
  // Игрок проходит их последовательно либо выбирает любую для повторения.
  missions: [
    {
      id: "movement",
      titleKey: "training.movement.title",
      descriptionKey: "training.movement.description",
      map: {
        width: 10,
        height: 8,
        pitChance: 0.08,
        coverDensity: 0.02,
        wallDensity: 0.02,
        edgeCoverChance: 0.3,
        halfCoverChance: 0.5,
        // Доводка 0.20.2: доля верхнего яруса поднята — урок «ярусы»
        // заметнее (прежняя карта имела лишь пару клеток z2).
        heightMix: { z0: 0.2, z1: 0.55, z2: 0.25 },
      },
      playerSlots: ["bogatyr"],
      // «Первые шаги» учат перемещению и рывку: противник здесь ни к чему и
      // только отвлекает (base-design §3.5, требование доработки обучения).
      // Окружение фиксировано — генератор получает постоянный seed, поэтому
      // ямы, укрытия и ярусы одинаковы при каждом прохождении.
      enemies: [],
      // Доводка 0.20.1: добавлен явный шаг «рывок» — перемещение за два
      // очка действия (шаги 3 и 5 — завершение хода между перемещениями).
      hints: [
        {
          step: 1,
          textKey: "training.movement.hint1",
          highlight: "panel",
          panelKey: "ap",
          until: "noop",
        },
        {
          step: 2,
          textKey: "training.movement.hint2",
          highlight: "cell",
          until: "move",
        },
        {
          step: 3,
          textKey: "training.movement.hint3",
          highlight: "button",
          panelKey: "end_turn",
          until: "end_turn",
        },
        {
          step: 4,
          textKey: "training.movement.hint4",
          highlight: "cell",
          until: "dash",
        },
        {
          step: 5,
          textKey: "training.movement.hint5",
          highlight: "button",
          panelKey: "end_turn",
          until: "end_turn",
        },
      ],
    },
    {
      id: "combat",
      titleKey: "training.combat.title",
      descriptionKey: "training.combat.description",
      // Доводка 0.20.1: minCovers гарантирует укрытие на карте — подсказка
      // про укрытие не бывает ложной; текст объясняет вероятность.
      map: {
        width: 10,
        height: 8,
        pitChance: 0.04,
        coverDensity: 0.08,
        wallDensity: 0.02,
        edgeCoverChance: 0.4,
        halfCoverChance: 0.5,
        heightMix: { z0: 0.15, z1: 0.7, z2: 0.15 },
        minCovers: 2,
      },
      playerSlots: ["bogatyr"],
      enemies: [{ unitId: "upyr", count: 1 }],
      hints: [
        {
          step: 1,
          textKey: "training.combat.hint1",
          highlight: "button",
          panelKey: "weapon",
          until: "attack",
        },
        {
          step: 2,
          textKey: "training.combat.hint2",
          highlight: "entity",
          targetUnitId: "upyr",
          until: "approach",
        },
      ],
    },
    {
      // «Умения и состояния» (0.19.1): кикимора вводит отравление и
      // воскрешение костяка, знахарка — лечение, очищение и призыв зверя;
      // дозор и туман войны действуют как обычно. Состав соответствует
      // описанию миссии (base-design §3.5).
      // Доводка 0.20.2: Навь в миссии действует, поэтому высадке дан и
      // Стрелец — дистанционный боец делает бой посильным для новичка.
      id: "skills",
      titleKey: "training.skills.title",
      descriptionKey: "training.skills.description",
      map: {
        width: 10,
        height: 8,
        pitChance: 0.04,
        coverDensity: 0.06,
        wallDensity: 0.02,
        edgeCoverChance: 0.4,
        halfCoverChance: 0.5,
        heightMix: { z0: 0.15, z1: 0.7, z2: 0.15 },
      },
      playerSlots: ["bogatyr", "znaharka", "strelets"],
      enemies: [
        { unitId: "upyr", count: 1 },
        { unitId: "kikimora", count: 1 },
      ],
      hints: [
        {
          step: 1,
          textKey: "training.skills.hint1",
          highlight: "button",
          panelKey: "skill",
          until: "skill",
        },
        {
          step: 2,
          textKey: "training.skills.hint2",
          highlight: "panel",
          panelKey: "defend",
          until: "defend",
        },
        {
          step: 3,
          textKey: "training.skills.hint3",
          highlight: "button",
          panelKey: "overwatch",
          until: "overwatch",
        },
      ],
      // Доводка 0.20.1: реактивные подсказки на отравление, воскрешение
      // и призыв показываются плашками в бою (ключи training.skills.note*).
      notes: {
        poison: "training.skills.notePoison",
        resurrect: "training.skills.noteResurrect",
        summon: "training.skills.noteSummon",
      },
    },
  ],
}
