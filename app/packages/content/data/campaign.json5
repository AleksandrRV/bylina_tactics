{
  // Кампания: Летучий Корабль, дружина, хозяйство, типы миссий.
  // Онбординг (0.20.0): точки открываются сканированием в порядке введения
  // механик — каждая новая механика появляется по одной:
  //   1. clearing_1   ближний бой (упырь);
  //   2. clearing_2   дистанция и удержание (леший);
  //   3. clearing_3   отравление и воскрешение (кикимора);
  //   4. destroy_idol_1  разрушение среды (идол);
  //   5. rescue_captive_1  эвакуация (спасение);
  //   6. recon_route_1  эвакуация (разведка);
  //   7. clearing_4   генерал Баба Яга;
  //   8. clearing_5   генерал Соловей-Разбойник.
  // Расстояния подобраны так, что из каждой точки открываются только
  // следующие по порядку (радиус сканирования scan.radius).
  rosterCap: 8,
  deployMin: 1,
  deployMax: 5,
  classUnlockLevel: 2,
  woundHpRatio: 0.3,
  darknessMax: 20,
  needleMissionId: "needle",
  recruitUnitId: "recruit",
  initialRoster: ["bogatyr", "strelets", "znaharka"],
  woundPenalty: { aim: -15, defense: -10, mobility: -1 },
  startingResources: { gold: 6, herbs: 3, artifacts: 0 },
  scan: {
    radius: 45,
    cost: { gold: 0, herbs: 1, artifacts: 0 },
  },
  // Древа талантов (0.21.30, campaign.md §4.1): начиная с 3-го уровня боец
  // выбирает один талант из двух. Талант — либо активное умение (skillId из
  // records `skills`), либо пассивная способность (passive). Класс, у
  // которого для уровня записи нет, растёт без выбора. Уровень 2 —
  // всегда выбор класса рекрутом (classUnlockLevel), а не талант.
  talents: {
    bogatyr: {
      "3": [
        { id: "circular_sweep", skillId: "circular_sweep" },
        { id: "iron_hide", passive: { maxHpMod: 2 } },
