# Среда пользователя (не исходный код).
# В этой песочнице домашний каталог совпадает с корнем репозитория,
# поэтому сюда попадают служебные папки инструментов. В обычной машине
# они лежат в профиле пользователя и в репозиторий не попадают.
.config/
.local/
.cache/
.npm/
.nvm/
.pnpm-store/
.yarn/
.yarnrc.yml

# Зависимости и блокировки посторонних менеджеров
node_modules/
**/node_modules/
package-lock.json
yarn.lock
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Сборка и кэш инструментов
dist/
**/dist/
dev-dist/
**/.vite/
.turbo/
.parcel-cache/
.eslintcache
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Секреты и локальные настройки
.env
.env.*
!.env.example
*.pem
*.key

# Система и редакторы
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Вложения среды разработки (не содержимое игры)
uploads/

# Collect files module
files-collector/
collect_files/
collect_files.bat
collect_files.py
collected_files.txt
collected_files_groups.js
collected_files_prefix.txt
